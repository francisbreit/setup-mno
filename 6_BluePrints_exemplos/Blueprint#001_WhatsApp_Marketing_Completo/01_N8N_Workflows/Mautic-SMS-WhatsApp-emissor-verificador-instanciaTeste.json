      "parameters": {
        "jsCode": "const min = 8; // tempo mínimo em segundos\nconst max = 10; // tempo máximo em segundos\n\n// Função para criar uma espera aleatória\nfunction randomWait(min, max) {\n  return new Promise((resolve) => {\n    const randomTime = Math.floor(Math.random() * (max - min + 1) + min) * 1000; // tempo aleatório em milissegundos\n    setTimeout(resolve, randomTime);\n  });\n}\n\n// Executa a função de espera\nawait randomWait(min, max);\n\nreturn [\n  {\n    json: {\n      success: true,\n    },\n  },\n];\n"
      },
