{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setupmno.local/schema/knowledge-document-v1.json",
  "title": "Setup MNO Knowledge Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "documentVersion",
    "contentSHA256",
    "documentType",
    "title",
    "setupVersion",
    "architectures",
    "category",
    "status",
    "updatedAt",
    "sourceType",
    "risk",
    "language",
    "tags",
    "sources",
    "homologation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "documentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contentSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "documentType": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "setupId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "setupVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "sourceType": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "language": {
      "const": "pt-BR"
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "title",
          "sourceType",
          "location",
          "license",
          "verifiedAt"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "sourceType": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "minLength": 3
          },
          "license": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "homologation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedAt",
        "verifiedPorts",
        "verifiedImages"
      ],
      "properties": {
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "verifiedPorts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "verifiedImages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "setup"
          }
        }
      },
      "then": {
        "required": [
          "setupId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "infrastructure"
          }
        }
      },
      "then": {
        "required": [
          "topicId"
        ]
      }
    }
  ]
}
