{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manualnegocioonline.com.br/schemas/official-homologation-seal.schema.json",
  "title": "Setup MNO Official Homologation Seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sealId",
    "setupId",
    "setupVersion",
    "issuedAt",
    "issuedBy",
    "reason",
    "architectures",
    "artifacts",
    "images",
    "evidenceRefs",
    "decisionRefs",
    "reviewPacks",
    "status",
    "immutable",
    "automaticPromotion",
    "officialSeal"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "setupmno-official-homologation-seal"},
    "sealId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-official$"},
    "setupId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "setupVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "issuedBy": {"type": "string", "minLength": 2, "maxLength": 80},
    "reason": {"type": "string", "minLength": 3, "maxLength": 240},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["amd64", "arm64"]}
    },
    "artifacts": {"$ref": "#/$defs/architectureReferences"},
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\S+@sha256:[a-f0-9]{64}$"}
    },
    "evidenceRefs": {"$ref": "#/$defs/architectureReferences"},
    "decisionRefs": {"$ref": "#/$defs/architectureReferences"},
    "reviewPacks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture", "sha256"],
        "properties": {
          "architecture": {"enum": ["amd64", "arm64"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "status": {"const": "issued"},
    "immutable": {"const": true},
    "automaticPromotion": {"const": false},
    "officialSeal": {"const": true}
  },
  "$defs": {
    "architectureReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture", "path", "sha256"],
        "properties": {
          "architecture": {"enum": ["amd64", "arm64"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
